# --- Core ---
# 32+ random bytes, base64. Used to encrypt guest link tokens at rest. Generate: openssl rand -base64 32
APP_SECRET=
APP_URL=http://localhost:3000

# --- Database ---
# Leave empty for local dev: an embedded PostgreSQL (PGlite) is stored in ./.data/pglite
# Production: a real Postgres URL (Supabase, Neon, RDS...). Run `npm run db:migrate` against it.
DATABASE_URL=

# --- First super admin (created by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Telegram (optional). Without it, notifications are recorded but not sent. ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI writing assistant (optional). Without it, the assistant shows a disabled state. ---
ANTHROPIC_API_KEY=

# --- Uploads ---
UPLOAD_DIR=./.data/uploads
MAX_UPLOAD_MB=8
TELEGRAM_WEBHOOK_SECRET=
AI_MODEL=
MAX_VIDEO_MB=60
